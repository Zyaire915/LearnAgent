# Local-development defaults only. Override credentials for any shared or remote database.
DB_URL=jdbc:postgresql://localhost:5432/learnagent
DB_USERNAME=learnagent
DB_PASSWORD=learnagent
SPRING_PROFILES_ACTIVE=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Doubao profile: set SPRING_PROFILES_ACTIVE=doubao and configure an Ark key.
ARK_API_KEY=
DOUBAO_CHAT_MODEL=
DOUBAO_TEMPERATURE=0.2
DOUBAO_REASONING_EFFORT=minimal
DOUBAO_MAX_COMPLETION_TOKENS=4096
LEARNAGENT_CHAT_PROVIDER=none
LEARNAGENT_EMBEDDING_PROVIDER=transformers
LEARNAGENT_VECTOR_STORE=pgvector
LOCAL_EMBEDDING_CACHE=.models/onnx
DJL_CACHE_DIR=.cache/djl-cpu
ENGINE_CACHE_DIR=.cache/djl-cpu/engine
TOKENIZERS_CACHE=.cache/djl-cpu/tokenizers
PYTORCH_FLAVOR=cpu
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_MIN_CHUNK_SIZE_CHARS=350
RAG_MAX_CHUNKS_PER_PAGE=100
CORS_ALLOWED_ORIGIN=http://localhost:5173
ANALYSIS_MINIMUM_ATTEMPTS=3
ANALYSIS_WEAK_POINT_THRESHOLD=0.6
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
LEARNAGENT_TIME_ZONE=Asia/Shanghai
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_CRON=0 0 20 * * SUN
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_CRON=0 0 8 * * *
MEMORY_REVIEW_ENABLED=true
MEMORY_REVIEW_CRON=0 0 8 * * *
LEARNAGENT_WORKSPACE_ROOT=workspaces
LEARNAGENT_DEMO_MODE=true
VITE_API_BASE_URL=http://localhost:8080
