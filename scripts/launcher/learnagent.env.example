# =====================================================================
# LearnAgent 便携版配置模板（learnagent.env）
#
# 使用方法：
#   1. 把本文件复制到数据目录并改名为 learnagent.env，例如
#        %LOCALAPPDATA%\LearnAgent\learnagent.env
#   2. 按需取消注释并填写，保存后重新双击 LearnAgent.exe。
#
# 安全说明（密钥外置）：
#   * API Key 只保存在本文件或源码仓库 .env 中，不写入仓库、不打包进发布包、
#     不编译进 LearnAgent.exe；
#   * 本文件优先于源码仓库的 .env；
#   * 缓存、模型、日志等目录由启动器自动重定向到数据目录，无需在此配置；
#   * 内置数据库的连接信息（DB_URL/DB_USERNAME/DB_PASSWORD）由启动器自动注入
#     （127.0.0.1:5433），一般无需在此填写。
# =====================================================================

# ---- AI 对话（三选一，全部留空时 AI 功能不可用，其余功能正常）----
#
# 方案 A：任意 OpenAI 兼容接口
#OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
#OPENAI_CHAT_MODEL=gpt-4o-mini
#LEARNAGENT_CHAT_PROVIDER=openai
#
# 方案 B：豆包（火山方舟 Ark）：先运行 scripts\configure-doubao.ps1 或在此填写
#ARK_API_KEY=xxxxxxxxxxxxxxxx
#DOUBAO_CHAT_MODEL=doubao-seed-2-0-mini-260428
#SPRING_PROFILES_ACTIVE=doubao
#
# 方案 C：不配置任何 Key（默认）

# ---- 联网搜索（可选）----
#TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ---- 本地向量检索（可选；发布包已内置 pgvector）----
#LEARNAGENT_EMBEDDING_PROVIDER=openai
#LEARNAGENT_VECTOR_STORE=pgvector

# ---- 数据库（一般无需填写，启动器会自动注入内置数据库配置）----
#DB_URL=jdbc:postgresql://127.0.0.1:5433/learnagent
#DB_USERNAME=learnagent
#DB_PASSWORD=learnagent

# ---- 其他（可选）----
#LEARNAGENT_TIME_ZONE=Asia/Shanghai
#WEEKLY_REVIEW_ENABLED=true
#DAILY_DIGEST_ENABLED=true
